generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StockRecord {
  id        String   @id @default(cuid())
  dateISO   String
  floor     String   @default("1")
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Snapshot {
  id        String   @id @default(cuid())
  name      String
  floor     String   @default("1")
  records   String
  createdAt DateTime @default(now())
}

model SharedLink {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
